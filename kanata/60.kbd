;; 按 /etc/keyd/60.conf 迁移；每层位置对应 defsrc，_ 透传到下层。
;; KG18 的硬件 Fn 和旋钮保持固件行为。
(defcfg
  process-unmapped-keys yes
  delegate-to-first-layer yes
  linux-dev-names-include ("SmartCloud KG18" "SmartCloud KG18 Keyboard")
  linux-continue-if-no-devs-found yes
  linux-output-device-name "kanata-60"
  movemouse-inherit-accel-state yes
  movemouse-smooth-diagonals yes
)

(defsrc
  esc      1        2        3        4        5        6        7        8        9        0        min      eql      bspc
  tab      q        w        e        r        t        y        u        i        o        p        lbrc     rbrc     bksl
  caps     a        s        d        f        g        h        j        k        l        scln     apos              ret      pgup
  lsft     z        x        c        v        b        n        m        comm     .        /                 rsft     up       pgdn
  lctl     lmet     lalt                       spc                                 ralt     rmet     rctl     left     down     rght
)

(defalias
  nav    (multi lmet (layer-while-held nav))
  caps   (tap-hold-release 0 200 esc @nav)
  enter  (tap-hold-release 0 200 ret @nav)
  space  (tap-hold-release 0 200 spc lctl)
  alt    (tap-hold-release 0 200 grv lalt)
  lshift (tap-hold-release 0 200 lbrc lsft)
  rshift (tap-hold-release 0 200 rbrc lsft)

  nup  (unmod (lmet) up)
  ndn  (unmod (lmet) down)
  nlf  (unmod (lmet) left)
  nrt  (unmod (lmet) rght)
  nhm  (unmod (lmet) home)
  nen  (unmod (lmet) end)
  npu  (unmod (lmet) pgup)
  npd  (unmod (lmet) pgdn)
  ndel (unmod (lmet) del)
  nf1  (unmod (lmet) f1)
  nf2  (unmod (lmet) f2)
  nf3  (unmod (lmet) f3)
  nf4  (unmod (lmet) f4)
  nf5  (unmod (lmet) f5)
  nf6  (unmod (lmet) f6)
  nf7  (unmod (lmet) f7)
  nf8  (unmod (lmet) f8)
  nf9  (unmod (lmet) f9)
  nf10 (unmod (lmet) f10)
  nf11 (unmod (lmet) f11)
  nf12 (unmod (lmet) f12)

  mouse  (multi (release-layer nav) (release-key lmet) (release-key rmet) (layer-switch mouse))
  normal (multi (release-key lmet) (release-key rmet) (layer-switch base))
  winx   (fork x @mouse (lmet rmet))
  mx     (fork XX @normal (lmet rmet))
  done   (multi mlft @normal)
  up     (movemouse-accel-up 10 650 1 12)
  down   (movemouse-accel-down 10 650 1 12)
  left   (movemouse-accel-left 10 650 1 12)
  right  (movemouse-accel-right 10 650 1 12)
  whup   (mwheel-up 80 120)
  whdn   (mwheel-down 80 120)
  whlf   (mwheel-left 80 120)
  whrt   (mwheel-right 80 120)
  slow   (movemouse-speed 25)
)

(deflayer base
  mlft     1        2        3        4        5        XX       XX       6        7        8        9        0        apos
  tab      q        w        e        r        t        eql      y        u        i        o        p        bspc     bksl
  @caps    a        s        d        f        g        min      h        j        k        l        scln              @enter   pgup
  @lshift  z        @winx    c        v        comm     .        b        n        m        /                 @rshift  up       pgdn
  lctl     lmet     @alt                       @space                              ralt     rmet     rctl     left     down     rght
)

(deflayer nav
  _        @nf1     @nf2     @nf3     @nf4     @nf5     _        _        @nf6     @nf7     @nf8     @nf9     @nf10    @nf11
  _        _        _        _        _        _        _        @npu     @nhm     @nup     @nen     _        @ndel    @nf12
  _        _        _        _        _        _        _        @npd     @nlf     @ndn     @nrt     _                 _        _
  _        _        _        _        _        _        _        _        _        _        _                 _        _        _
  _        _        _                          _                                   _        _        _        _        _        _
)

;; 鼠标层按右移后的逻辑 IJKL/UO/YH；其余字母不输出，无中键。
(deflayer mouse
  @normal  XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX
  XX       XX       XX       XX       XX       XX       XX       @whup    @whlf    @up      @whrt    XX       XX       XX
  @normal  XX       @slow    mrgt     mlft     XX       XX       @whdn    @left    @down    @right   XX                @done    @whup
  lsft     XX       @mx      XX       XX       XX       XX       XX       XX       XX       XX                rsft     @up      @whdn
  lctl     lmet     lalt                       XX                                  ralt     rmet     rctl     @left    @down    @right
)
