<?xml version="1.0"?>
<labwc_config>
  <desktops number="3">
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
    </names>
  </desktops>

  <keyboard>
    <repeatDelay>200</repeatDelay>
    <repeatRate>30</repeatRate>
    <default />
    <keybind key="W-b">
      <action name="Execute" command="sh -c 's=org.gnome.desktop.interface; case $(gsettings get $s color-scheme) in *dark*) gsettings set $s color-scheme prefer-light; gsettings set $s gtk-theme Adwaita;; *) gsettings set $s color-scheme prefer-dark; gsettings set $s gtk-theme Adwaita-dark;; esac'" />
    </keybind>
    <keybind key="W-Escape" onRelease="yes">
      <action name="Execute" command="pkill -USR1 -x swayidle" />
    </keybind>
    <keybind key="XF86MonBrightnessDown" allowWhenLocked="yes">
      <action name="Execute" command="brightnessctl set 1%-" />
    </keybind>
    <keybind key="XF86MonBrightnessUp" allowWhenLocked="yes">
      <action name="Execute" command="brightnessctl set 1%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+" />
    </keybind>
    <keybind key="XF86AudioMute" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="sh -c 'grim - | swappy -f - -o - | wl-copy -t image/png'" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; - | swappy -f - -o - | wl-copy -t image/png'" />
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" toggle="yes" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" toggle="yes" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" toggle="yes" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="alacritty" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
  </keyboard>

  <focus>
    <followMouse>yes</followMouse>
  </focus>

  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
      <tapAndDrag>yes</tapAndDrag>
      <disableWhileTyping>yes</disableWhileTyping>
      <naturalScroll>yes</naturalScroll>
      <scrollMethod>twofinger</scrollMethod>
      <scrollFactor>0.85</scrollFactor>
      <accelProfile>adaptive</accelProfile>
      <pointerSpeed>0.2</pointerSpeed>
      <clickMethod>clickfinger</clickMethod>
    </device>
    <device category="non-touch">
      <pointerSpeed>0.2</pointerSpeed>
    </device>
  </libinput>

  <windowSwitcher>
    <osd style="thumbnail" />
  </windowSwitcher>

  <!-- 所有窗口不使用合成器标题栏和边框。 -->
  <windowRules>
    <windowRule identifier="*">
      <action name="SetDecorations" decorations="none" />
    </windowRule>
  </windowRules>
</labwc_config>
