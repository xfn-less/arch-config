#!/usr/bin/env python3
"""Temporary fan-only tests for MS-14K2 / 14K2EMS1.110. No boot integration."""
import argparse
import contextlib
import fcntl
import os
from pathlib import Path
import signal
import subprocess
import time

CPU = (0x72, [0, 36, 40, 50, 62, 80, 96])
GPU = (0x8a, [0, 36, 42, 50, 62, 80, 96])
DEBUG = Path('/sys/kernel/debug')

def run(*args):
    subprocess.run(args, check=True)

def curve(text):
    try:
        values = [int(v) for v in text.split(',')]
    except ValueError as e:
        raise argparse.ArgumentTypeError('Use seven comma-separated integers') from e
    if len(values) != 7 or any(v < 0 or v > 100 for v in values):
        raise argparse.ArgumentTypeError('Need seven speeds in 0..100')
    if values != sorted(values):
        raise argparse.ArgumentTypeError('Speeds must not decrease as temperature rises')
    return values

@contextlib.contextmanager
def access():
    loaded = False
    mounted = False
    fd = None
    try:
        if not Path('/sys/module/ec_sys').exists():
            run('modprobe', 'ec_sys', 'write_support=1')
            loaded = True
        if Path('/sys/module/ec_sys/parameters/write_support').read_text().strip() != 'Y':
            raise RuntimeError('Existing ec_sys module is read-only; refusing to change it')
        if not os.path.ismount(DEBUG):
            run('mount', '-t', 'debugfs', 'debugfs', str(DEBUG))
            mounted = True
        fd = os.open(DEBUG / 'ec/ec0/io', os.O_RDWR)
        yield fd
    finally:
        if fd is not None:
            os.close(fd)
        if mounted:
            run('umount', str(DEBUG))
        if loaded:
            run('modprobe', '-r', 'ec_sys')

def read(fd, addr, count=1):
    data = os.pread(fd, count, addr)
    if len(data) != count:
        raise RuntimeError('Short EC read')
    return data

def write(fd, addr, value):
    if os.pwrite(fd, bytes([value]), addr) != 1 or read(fd, addr)[0] != value:
        raise RuntimeError(f'EC write/readback mismatch at {addr:#x}')

def stop(signum, frame):
    raise KeyboardInterrupt

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--minutes', type=float, default=10, help='Test duration (0.1..30), then restore; default 10')
    parser.add_argument('--cpu', type=curve, default=curve('30,36,40,50,62,80,96'))
    parser.add_argument('--gpu', type=curve, default=curve('30,36,42,50,62,80,96'))
    args = parser.parse_args()
    if not 0.1 <= args.minutes <= 30:
        parser.error('Test duration must be 0.1..30 minutes')
    for name, values, (_, baseline) in [('CPU', args.cpu, CPU), ('GPU', args.gpu, GPU)]:
        if any(v < b for v, b in zip(values, baseline)):
            parser.error(f'{name}: reducing stock speeds is not allowed by this test tool')
    if os.geteuid() != 0:
        parser.error('Run using sudo')
    lock = open('/run/lock/msi-fan.lock', 'a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        parser.error('Another fan controller is running; stop msi-fan service before testing')
    if Path('/sys/class/dmi/id/board_name').read_text().strip() != 'MS-14K2':
        raise RuntimeError('Wrong motherboard; refusing EC access')
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    with access() as fd:
        if read(fd, 0xa0, 12) != b'14K2EMS1.110':
            raise RuntimeError('Wrong EC firmware; refusing writes')
        for base, baseline in [CPU, GPU]:
            if list(read(fd, base, 7)) != baseline:
                raise RuntimeError('Curve differs from verified stock baseline; refusing writes')
        if read(fd, 0xd4)[0] != 0x0d or read(fd, 0x98)[0] & 0x80:
            raise RuntimeError('Expected automatic mode with Cooler Boost off')
        # Only speeds and fan mode are touched. Temperature thresholds and
        # charging, performance, keyboard and all other EC settings stay intact.
        snapshot = {a: read(fd, a)[0] for a in
                    list(range(0x72, 0x79)) + list(range(0x8a, 0x91)) + [0xd4]}
        changed = []
        try:
            for base, values in [(CPU[0], args.cpu), (GPU[0], args.gpu)]:
                for i, value in enumerate(values):
                    addr = base + i
                    if value != snapshot[addr]:
                        changed.append(addr)
                        write(fd, addr, value)
            changed.append(0xd4)
            write(fd, 0xd4, 0x8d)
            print('Temporary CPU:', args.cpu, 'GPU:', args.gpu, flush=True)
            print('Keep this terminal open. Ctrl+C restores immediately. No boot persistence.', flush=True)
            end = time.monotonic() + args.minutes * 60
            while time.monotonic() < end:
                if read(fd, 0xd4)[0] != 0x8d or read(fd, 0x98)[0] & 0x80:
                    raise RuntimeError('External mode change detected; ending test')
                temp = read(fd, 0x68)[0]
                print(f'CPU {temp} C | fan1 {read(fd, 0x71)[0]} | fan2 {read(fd, 0x89)[0]}', flush=True)
                if temp >= 80:
                    raise RuntimeError('Temperature safety stop at 80 C')
                for base, values in [(CPU[0], args.cpu), (GPU[0], args.gpu)]:
                    if list(read(fd, base, 7)) != values:
                        raise RuntimeError('External curve change detected; ending test')
                time.sleep(min(5, max(0, end - time.monotonic())))
        except KeyboardInterrupt:
            print('Stopping test...', flush=True)
        finally:
            errors = []
            for addr in changed:
                try:
                    write(fd, addr, snapshot[addr])
                except Exception as e:
                    errors.append(str(e))
            if errors:
                raise RuntimeError('RESTORE FAILED: ' + '; '.join(errors))
            print('Original curve and automatic mode restored and verified.', flush=True)

if __name__ == '__main__':
    main()
